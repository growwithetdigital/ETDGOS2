{
  "entities": {
    "booking": {
      "title": "Booking",
      "description": "A book a free session lead submission.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Prospect full name" },
        "email": { "type": "string", "format": "email", "description": "Prospect contact email" },
        "company": { "type": "string", "description": "Company or brand name" },
        "objective": { "type": "string", "description": "Primary business growth objective" },
        "notes": { "type": "string", "description": "Optional details about marketing goals" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp of creation" }
      },
      "required": ["name", "email", "company", "objective"]
    },
    "playbook_download": {
      "title": "Playbook Download Lead",
      "description": "Prospects downloading the Digital Growth Playbook.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "company": { "type": "string" },
        "resource": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email"]
    },
    "audit": {
      "title": "Website Growth Audit",
      "description": "Website audit data captured before or during onboarding.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Bound user UID or null for anonymous" },
        "website_url": { "type": "string" },
        "business_name": { "type": "string" },
        "primary_niche": { "type": "string" },
        "target_audience": { "type": "string" },
        "growth_bottlenecks": { "type": "array", "items": { "type": "string" } },
        "current_monthly_visitors": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["website_url", "business_name"]
    },
    "user_profile": {
      "title": "User Profile",
      "description": "User account and tier status with 90-day rate limit tracking, Business DNA, and cross-device dashboard progress.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "tier": { "type": "string", "enum": ["free", "monthly", "consultation"] },
        "status": { "type": "string", "enum": ["active", "suspended", "canceled"] },
        "has_seen_welcome": { "type": "boolean" },
        "last_generated_timestamp": { "type": "string", "format": "date-time" },
        "next_eligible_timestamp": { "type": "string", "format": "date-time" },
        "total_generations_count": { "type": "number" },
        "audit_id": { "type": "string" },
        "business_name": { "type": "string" },
        "website_url": { "type": "string" },
        "industry": { "type": "string" },
        "selected_tone": { "type": "string" },
        "is_profile_locked": { "type": "boolean" },
        "profile_locked_at": { "type": "string", "format": "date-time" },
        "brand_dna": { "type": "object" },
        "dashboard_progress": { "type": "object" },
        "active_session": { "type": "object" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "tier", "has_seen_welcome"]
    },
    "content_library_item": {
      "title": "Generated Growth Content",
      "description": "SEO blog post, social captions, and branded AI graphic.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "type": { "type": "string" },
        "blog_post": { "type": "object" },
        "social_captions": { "type": "object" },
        "graphic": { "type": "object" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "uid", "blog_post", "social_captions", "graphic"]
    },
    "platform_telemetry": {
      "title": "Platform Telemetry Event",
      "description": "Administrative usage event for tracking logins, content generations, and audits.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "userEmail": { "type": "string", "format": "email" },
        "userName": { "type": "string" },
        "action": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "uid", "action", "timestamp"]
    },
    "downloaded_asset": {
      "title": "Downloaded Asset",
      "description": "Archived high-resolution editorial graphics and promotional assets synced across desktop and mobile devices.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "title": { "type": "string" },
        "formatId": { "type": "string" },
        "formatName": { "type": "string" },
        "dimensions": { "type": "string" },
        "dataUrl": { "type": "string" },
        "downloadedAt": { "type": "string", "format": "date-time" },
        "filename": { "type": "string" }
      },
      "required": ["id", "title", "formatId", "formatName", "dimensions", "downloadedAt", "filename"]
    }
  },
  "firestore": {
    "platform_telemetry/{docId}": {
      "schema": "platform_telemetry",
      "description": "Administrative event telemetry readable exclusively by owner admin."
    },
    "bookings/{bookingId}": {
      "schema": "booking",
      "description": "Leads submitted via the branded Book a Free Session form."
    },
    "playbook_downloads/{leadId}": {
      "schema": "playbook_download",
      "description": "Leads submitted to download the playbook."
    },
    "audits/{auditId}": {
      "schema": "audit",
      "description": "Website diagnostic audits."
    },
    "users/{userId}": {
      "schema": "user_profile",
      "description": "User profile with tier and onboarding status."
    },
    "users/{userId}/content_library/{contentId}": {
      "schema": "content_library_item",
      "description": "User generated content library items."
    },
    "users/{userId}/downloaded_assets/{assetId}": {
      "schema": "downloaded_asset",
      "description": "User archived graphic assets synchronized across devices."
    },
    "universal_profiles/{profileId}": {
      "schema": "user_profile",
      "description": "Universal user profile and Business DNA synchronized across all devices by email."
    },
    "universal_profiles/{profileId}/downloaded_assets/{assetId}": {
      "schema": "downloaded_asset",
      "description": "Universal archived graphic assets synchronized across all browsers and devices by email."
    },
    "universal_sessions/{sessionId}": {
      "schema": "user_profile",
      "description": "Universal active session persistence records synchronized across all devices and browsers."
    }
  }
}
